# BeauxWorks — Local Development Environment
# Copy this file to .env and fill in actual values.
# NEVER commit .env to source control.

# SQL Server connection
BEAUXWORKS_SQL_SERVER=CHAMBERLAIN-PC
BEAUXWORKS_SQL_DATABASE=BeauxWorks
BEAUXWORKS_SQL_USER=sa
BEAUXWORKS_SQL_PASSWORD=your_password_here
BEAUXWORKS_SQL_DRIVER=ODBC Driver 17 for SQL Server
# Set to true for Windows Authentication (ignores SQL_USER/SQL_PASSWORD)
BEAUXWORKS_SQL_TRUSTED_CONNECTION=false

# JWT secrets (generate random 64+ character strings)
BEAUXWORKS_JWT_ACCESS_SECRET=generate_a_random_secret_here
BEAUXWORKS_JWT_REFRESH_SECRET=generate_another_random_secret_here
BEAUXWORKS_JWT_ACCESS_EXPIRES_MINUTES=15
BEAUXWORKS_JWT_REFRESH_EXPIRES_DAYS=7

# MFA encryption key (32-byte hex string for AES-256 encryption of TOTP secrets)
BEAUXWORKS_MFA_ENCRYPTION_KEY=generate_a_64_char_hex_string_here

# Account lockout
BEAUXWORKS_MAX_FAILED_LOGINS=5
BEAUXWORKS_LOCKOUT_DURATION_MINUTES=15

# Server
BEAUXWORKS_API_PORT=8000
BEAUXWORKS_DEBUG=false
BEAUXWORKS_CORS_ORIGINS=http://localhost:5173
